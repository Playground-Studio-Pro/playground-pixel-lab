{
  "name": "pixel-lab-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated Pixel Lab Electron foundation",
  "author": "Pixel Lab",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "electron . --smoke-test",
    "stage": "node scripts/stage.mjs",
    "build:web": "node scripts/build-web.mjs",
    "pack:mac": "npm run build:web && electron-builder --mac --arm64 --dir --publish never",
    "dist:mac": "npm run build:web && electron-builder --mac --arm64 --publish never",
    "dist:win": "npm run build:web && electron-builder --win --x64 --publish never",
    "postinstall": "install-electron --no"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12"
  }
}
